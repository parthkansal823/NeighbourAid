# Optional OFFLINE two-stage AI configuration for `npm run server:ai:connect`.
# Copy this file to deploy/laptop/ai.env; it is machine-local and ignored.
#
# Paths below are inside the API container. The AI Compose override bind-mounts
# the repository's gitignored models/ directory at /models read-only. Download
# weights yourself before connecting; neither Docker nor the app fetches them.
# Do not put an API key, tunnel URL, EDGE_SECRET, JWT_SECRET or MongoDB
# credential in this file.

# Fast first pass: small Gemma GGUF. An approval publishes ordinary reports
# immediately; an uncertain answer is sent to the stronger verifier while the
# report is briefly held. A missing/unreadable first-pass model preserves the
# deterministic alert flow instead of holding the alert.
LLM_MODEL_PATH=/models/gemma-3-1b-it-Q4_K_M.gguf

# Stronger, slower second stage: Qwen 2.5 3B GGUF. This is the sensible local
# default beside Gemma 1B. A laptop with measured RAM headroom can instead use
# /models/Qwen2.5-7B-Instruct-Q4_K_M.gguf; keep it separate from Gemma.
LLM_VERIFIER_MODEL_PATH=/models/qwen2.5-3b-instruct-q4_k_m.gguf

# Optional llama.cpp tuning. These are the code defaults; leave them unchanged
# unless the laptop has been measured under real load. Context is 1024–16384,
# timeout 1–300 seconds, threads 1–64, and GPU layers >=0 (0 = CPU only).
LLM_TIMEOUT_SECONDS=20
LLM_CONTEXT_TOKENS=2048
LLM_THREADS=4
LLM_GPU_LAYERS=0
LLM_VERIFIER_TIMEOUT_SECONDS=45
LLM_VERIFIER_CONTEXT_TOKENS=4096
LLM_VERIFIER_THREADS=4
LLM_VERIFIER_GPU_LAYERS=0
