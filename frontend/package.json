{
  "name": "neighbouraid-frontend",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run",
    "demo:build": "vite build --mode demo && node scripts/promote-demo-html.mjs",
    "demo:deploy": "npm run demo:build && wrangler deploy --config wrangler.demo.jsonc",
    "demo:deploy:dry": "npm run demo:build && wrangler deploy --config wrangler.demo.jsonc --dry-run",
    "set-api": "node scripts/set-api.mjs",
    "server:setup": "node scripts/docker-server.mjs setup",
    "server:init": "node scripts/docker-server.mjs init",
    "server:backup": "node scripts/docker-server.mjs backup",
    "server:rotate": "node scripts/docker-server.mjs rotate",
    "server:test": "node scripts/server-smoke.mjs",
    "server:connect": "node scripts/docker-server.mjs connect",
    "server:stop": "node scripts/docker-server.mjs stop",
    "server:status": "node scripts/docker-server.mjs status",
    "mobile:build": "vite build --mode mobile && npx cap sync",
    "mobile:copy": "vite build --mode mobile && npx cap copy",
    "mobile:sync": "vite build --mode mobile && npx cap sync",
    "mobile:apk": "npm run mobile:sync && cd android && gradlew.bat assembleDebug",
    "mobile:doctor": "npx cap doctor",
    "assets:generate": "node scripts/brand-assets.mjs && capacitor-assets generate --android --iconBackgroundColor \"#000000\" --iconBackgroundColorDark \"#000000\" --splashBackgroundColor \"#000000\" --splashBackgroundColorDark \"#000000\" --logoSplashScale 0.4",
    "mobile:add:android": "npx cap add android",
    "mobile:open:android": "npx cap open android",
    "mobile:android": "npm run mobile:sync && npx cap open android",
    "mobile:add:ios": "npx cap add ios",
    "mobile:open:ios": "npx cap open ios",
    "mobile:ios": "npm run mobile:sync && npx cap open ios",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:tools": "node --test scripts/*.test.mjs",
    "check:private": "node scripts/check-private-files.mjs",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@neighbouraid/app-updater": "file:native/app-updater",
    "@neighbouraid/speech-input": "file:native/speech-input",
    "@tanstack/react-query": "^5.104.1",
    "axios": "^1.19.0",
    "jwt-decode": "^4.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.31.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^4.1.11",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.10.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.32",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0",
    "wrangler": "^4.131.0"
  },
  "_overrides_note": "Security floors for build tooling. Scope brace-expansion to the consuming minimatch major: 3.x uses 1.x, 8.x uses 2.x, and 10.x uses 5.x. A broad @capacitor/cli override also affects the assets tool's legacy CLI, making npm 10 and 11 disagree when regenerating the lockfile. Drop these floors once upstream dependencies select patched versions themselves.",
  "overrides": {
    "sharp": "$sharp",
    "tar": ">=7.5.21",
    "uuid": ">=11.1.1",
    "minimatch@^3.0.0": {
      "brace-expansion": "^1.1.21"
    },
    "minimatch@^8.0.0": {
      "brace-expansion": "^2.1.7"
    },
    "minimatch@^10.0.0": {
      "brace-expansion": "^5.0.12"
    }
  }
}
