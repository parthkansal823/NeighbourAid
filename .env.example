# Host development / optional integration template; keep real values private.
# The Docker laptop stack generates its own JWT/database credentials instead.
# See DEPLOY.md; do not replace generated private files with this template.

# Backend — required
# -----------------------------------------------------------------------

# Signing key for auth tokens. Generate your OWN — do not ship the sample
# below. Anyone who knows this value can mint a token for any user and any
# role, so treat it like a database password.
#   openssl rand -hex 32
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-freshly-generated-random-value

# Defaults to `production` in code, so a deploy that sets nothing still gets
# the strict startup checks. Set it to `development` for local work — that
# relaxes the "JWT_SECRET is the public dev default" and "MONGO_URL points at
# localhost" checks from fatal errors into warnings.
ENVIRONMENT=development

# MongoDB connection string. Defaults to localhost; for Atlas use the
# mongodb+srv://... URI from the cluster's "Connect" button.
MONGO_URL=mongodb://localhost:27017/neighbouraid

# -----------------------------------------------------------------------
# Backend — optional
# -----------------------------------------------------------------------

# Comma-separated extra CORS origins. The wildcard regex already covers
# *.pages.dev, *.workers.dev, *.hf.space, *.vercel.app and
# *.netlify.app — only set this for a custom domain.
# FRONTEND_ORIGINS=https://app.example.com,https://staging.example.com

# Optional outbound webhook fired on every new alert. Designed for n8n,
# Zapier, Make, or a custom worker — point this at a webhook trigger and
# the automation can fan out to Slack/WhatsApp/SMS/email. Leave empty
# (or unset) to disable. Fire-and-forget — alert creation never blocks
# on the webhook.
# ALERT_WEBHOOK_URL=https://n8n.example.com/webhook/neighbouraid
# ALERT_WEBHOOK_TIMEOUT_SECONDS=4

# Shared secret for the inbound WhatsApp webhook (POST /api/inbound/whatsapp).
# The gateway must include this in the `X-Inbound-Token` header. Empty
# disables the route (returns 503).
# INBOUND_TOKEN=

# Web push (notifies volunteers whose tab is closed). Off unless BOTH
# keys are set. Generate a pair with:
#     python -m app.services.push
# The private key is a credential — treat it like JWT_SECRET. Rotating
# it invalidates every existing subscription, because a browser binds
# a subscription to the public key it was created with.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com

# Optional fully local, two-stage AI review. Both are GGUF files loaded with
# llama.cpp in the backend process; no report text is sent to a model API.
# Install backend/requirements-llm.txt separately before enabling this in a
# host-development environment. A small Gemma first pass can approve an
# ordinary MEDIUM/LOW report for immediate publication; its uncertainty is
# sent to the stronger Qwen verifier while briefly held. Missing/unreadable
# models, timeouts and malformed output fall back to deterministic visibility
# — they never block an alert indefinitely. `NA_DISABLE_AI_MODEL=1` disables text, verifier and
# vision models together.
#
# For the Docker laptop AI stack, do NOT use host paths here. Copy
# deploy/laptop/ai.env.example to deploy/laptop/ai.env instead; it uses
# read-only /models container paths and `npm run server:ai:connect`.
# LLM_MODEL_PATH=../models/gemma-3-1b-it-Q4_K_M.gguf
# LLM_VERIFIER_MODEL_PATH=../models/qwen2.5-3b-instruct-q4_k_m.gguf
# LLM_TIMEOUT_SECONDS=20
# LLM_CONTEXT_TOKENS=2048
# LLM_THREADS=4
# LLM_GPU_LAYERS=0
# LLM_VERIFIER_TIMEOUT_SECONDS=45
# LLM_VERIFIER_CONTEXT_TOKENS=4096
# LLM_VERIFIER_THREADS=4
# LLM_VERIFIER_GPU_LAYERS=0

# -----------------------------------------------------------------------
# Frontend — only needed if backend runs on a different host
# -----------------------------------------------------------------------

# Absolute backend URL in production. Empty = same-origin (Vite proxies in dev).
# In the Worker edge-proxy setup in DEPLOY.md, leave BOTH unset and use
# VITE_EDGE_PROXY=1 in frontend/.env.production. Only direct-API hosting needs
# explicit public API/WebSocket origins below.
#   VITE_API_URL=https://neighbouraid-api.onrender.com
VITE_API_URL=

# Absolute backend WebSocket URL in production. Must be wss:// (not ws://)
# behind TLS — a browser on an https:// page blocks insecure WebSockets, and
# the failure is silent in the volunteer feed.
#   VITE_WS_URL=wss://neighbouraid-api.onrender.com
VITE_WS_URL=
